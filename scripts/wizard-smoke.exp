#!/usr/bin/expect -f
# Wizard smoke test in a pseudo-TTY: goes through all steps and saves the config.
set timeout 30
set env(TERM) xterm-256color

# Answers a prompt: waits for the text, lets the interface render and sends the reply.
proc answer {pattern reply} {
    expect -re $pattern
    after 250
    send -- "$reply"
}

spawn bun run src/index.ts -c /tmp/exdbnein-config.json

answer "Target disk" "/dev/sda\r"
answer "Partitioning scheme" "\r"
answer "Filesystem" "\r"
answer "subvolumes" "\r"
answer "swap partition" "\r"
answer "Swap size" "\r"

answer "Locale" "en_US.UTF-8\r"
answer "Keyboard layout" "us\r"
answer "Time zone" "UTC\r"

answer "Hostname" "testbox\r"
answer "Network manager" "\r"

answer "Root password" "rootpass\r"
answer "Username" "alice\r"
answer "Password for alice" "alicepass\r"
answer "sudo group" "\r"
answer "another user" "\r"

answer "Start installation" "\r"

expect eof